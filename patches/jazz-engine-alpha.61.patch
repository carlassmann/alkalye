+
+fn text_edit_from_splice(
+    mutation: &JsValue,
+    cache: &RefCell<Option<DecodedText>>,
+) -> Option<LargeValueUpdate> {
+    let get = |key: &str| js_sys::Reflect::get(mutation, &JsValue::from_str(key)).ok();
+    if get("kind")?.as_string()?.as_str() != "text_edit" {
+        return None;
+    }
+    let splice: TextEditSplice = serde_wasm_bindgen::from_value(get("text_splice")?).ok()?;
+    let source = get("edited_from")?.dyn_into::<js_sys::JsString>().ok()?;
+    let replacement = get("text")?.dyn_into::<js_sys::JsString>().ok()?;
+    let length = source.length();
+    if splice.from > splice.to || splice.to > length {
+        return None;
+    }
+    let inserted = u32::try_from(splice.insert.encode_utf16().count()).ok()?;
+    let new_end = splice.from.checked_add(inserted)?;
+    if splits_js_surrogate(&replacement, splice.from) || splits_js_surrogate(&replacement, new_end)
+    {
+        return None;
+    }
+    // Validate the advisory delta in JS, avoiding another whole-value UTF-8 copy.
+    let expected = source
+        .slice(0, splice.from)
+        .concat(&JsValue::from_str(&splice.insert))
+        .concat(source.slice(splice.to, length).as_ref());
+    if !js_sys::Object::is(expected.as_ref(), replacement.as_ref()) {
+        return None;
+    }
+    let column = get("column")?.as_string()?;
+    // An exact previous JS value already has its normal UTF-8 conversion.
+    let cached = cache.borrow_mut().take();
+    let edited_from = match cached {
+        Some(cached) if js_sys::Object::is(cached.javascript.as_ref(), source.as_ref()) => {
+            cached.utf8
+        }
+        _ => source.as_string()?,
+    };
+    let from = text_byte_offset(&edited_from, splice.from, length)?;
+    let to = text_byte_offset(&edited_from, splice.to, length)?;
+    let mut text = edited_from.clone();
+    text.replace_range(from..to, &splice.insert);
+    if text.len() <= 64 * 1024 * 1024 {
+        cache.replace(Some(DecodedText {
+            javascript: replacement,
+            utf8: text.clone(),
+        }));
+    }
+    Some(LargeValueUpdate::TextEdit {
+        column,
+        text,
+        edited_from,
     })

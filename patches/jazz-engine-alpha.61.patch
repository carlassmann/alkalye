+/// Reuse validated logical bytes when an immutable base has only gained edits.
+/// The caller must supply bytes previously returned for `previous`.
+pub fn materialize_from_previous(
+    value: &LargeValueRef,
+    previous: &LargeValueRef,
+    bytes: &[u8],
+) -> Result<Option<Vec<u8>>, Error> {
+    if value.kind != previous.kind
+        || value.format_version != previous.format_version
+        || value.root != previous.root
+        || value.logical_hash != previous.logical_hash
+        || !value.edit_tail.starts_with(&previous.edit_tail)
+    {
+        return Ok(None);
+    }
+    validate_descriptor(value)?;
+    let mut bytes = bytes.to_vec();
+    let suffix = &value.edit_tail[previous.edit_tail.len()..];
+    let actual = if value.kind == LargeValueKind::String {
+        let mut utf16 = previous.utf16_length.ok_or(Error::MalformedScalar)?;
+        for edit in suffix {
+            let start = usize::try_from(edit.offset).map_err(|_| Error::MetricOverflow)?;
+            let end = start
+                .checked_add(
+                    usize::try_from(edit.delete_length).map_err(|_| Error::MetricOverflow)?,
+                )
+                .ok_or(Error::MetricOverflow)?;
+            if end > bytes.len() {
+                return Err(Error::MalformedNode);
+            }
+            // Cached text is valid UTF-8. Boundary-preserving edits keep it valid.
+            let boundary = |at: usize| at == bytes.len() || bytes[at] & 0xc0 != 0x80;
+            if !boundary(start) || !boundary(end) {
+                return Ok(None);
+            }
+            let deleted = std::str::from_utf8(&bytes[start..end])
+                .map_err(|_| Error::InvalidUtf8)?
+                .encode_utf16()
+                .count() as u64;
+            utf16 = utf16
+                .checked_sub(deleted)
+                .and_then(|n| n.checked_add(edit.insert_utf16_length))
+                .ok_or(Error::MetricOverflow)?;
+            apply_edits(&mut bytes, std::slice::from_ref(edit))?;
+        }
+        NodeMetrics {
+            byte_length: bytes.len() as u64,
+            utf16_length: Some(utf16),
+        }
+    } else {
+        apply_edits(&mut bytes, suffix)?;
+        validate_logical(value.kind, &bytes)?;
+        metrics(value.kind, &bytes)?
+    };
+    if actual.byte_length != value.byte_length || actual.utf16_length != value.utf16_length {
+        return Err(Error::DescriptorMismatch);
+    }
+    Ok(Some(bytes))
+}

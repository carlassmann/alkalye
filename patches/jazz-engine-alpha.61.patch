+fn text_edit_from_splice(mutation: &JsValue) -> Option<LargeValueUpdate> {
+    let get = |key: &str| js_sys::Reflect::get(mutation, &JsValue::from_str(key)).ok();
+    if get("kind")?.as_string()?.as_str() != "text_edit" {
+        return None;
+    }
+    let splice: TextEditSplice = serde_wasm_bindgen::from_value(get("text_splice")?).ok()?;
+    let source = get("edited_from")?.dyn_into::<js_sys::JsString>().ok()?;
+    let replacement = get("text")?.dyn_into::<js_sys::JsString>().ok()?;
+    let length = source.length();
+    if splice.from > splice.to || splice.to > length {
+        return None;
+    }
+    let inserted = u32::try_from(splice.insert.encode_utf16().count()).ok()?;
+    let new_end = splice.from.checked_add(inserted)?;
+    if splits_js_surrogate(&replacement, splice.from) || splits_js_surrogate(&replacement, new_end)
+    {
+        return None;
+    }
+    // Validate the advisory delta in JS, avoiding another whole-value UTF-8 copy.
+    let expected = source
+        .slice(0, splice.from)
+        .concat(&JsValue::from_str(&splice.insert))
+        .concat(source.slice(splice.to, length).as_ref());
+    if !js_sys::Object::is(expected.as_ref(), replacement.as_ref()) {
+        return None;
+    }
+    let edited_from = source.as_string()?;
+    let from = text_byte_offset(&edited_from, splice.from, length)?;
+    let to = text_byte_offset(&edited_from, splice.to, length)?;
+    let mut text = edited_from.clone();
+    text.replace_range(from..to, &splice.insert);
+    Some(LargeValueUpdate::TextEdit {
+        column: get("column")?.as_string()?,
+        text,
+        edited_from,
     })
 }
 
+fn splits_js_surrogate(text: &js_sys::JsString, position: u32) -> bool {
+    if position == 0 || position >= text.length() {
+        return false;
+    }
+    (0xd800 as f64..=0xdbff as f64).contains(&text.char_code_at(position - 1))
+        && (0xdc00 as f64..=0xdfff as f64).contains(&text.char_code_at(position))
+}
+
+fn text_byte_offset(text: &str, position: u32, length: u32) -> Option<usize> {
+    if position > length {
+        return None;
+    }
+    if position <= length / 2 {
+        let mut remaining = position;
+        for (offset, character) in text.char_indices() {
+            if remaining == 0 {
+                return Some(offset);
+            }
+            remaining = remaining.checked_sub(character.len_utf16() as u32)?;
+        }
+        (remaining == 0).then_some(text.len())
+    } else {
+        let mut remaining = length - position;
+        let mut offset = text.len();
+        for character in text.chars().rev() {
+            if remaining == 0 {
+                return Some(offset);
+            }
+            remaining = remaining.checked_sub(character.len_utf16() as u32)?;
+            offset -= character.len_utf8();
+        }
+        (remaining == 0).then_some(offset)
+    }
+}
+
+fn large_value_updates(mutations: JsValue) -> Result<Vec<LargeValueUpdate>, JsValue> {
+    if !js_sys::Array::is_array(&mutations) {
+        return Err(JsValue::from_str(
+            "invalid partial-value update descriptor: expected an array",
+        ));
+    }
+    js_sys::Array::from(&mutations)
+        .iter()
+        .map(|mutation| {
+            if let Some(update) = text_edit_from_splice(&mutation) {
+                return Ok(update);
+            }
+            serde_wasm_bindgen::from_value(mutation).map_err(|error| {
+                JsValue::from_str(&format!("invalid partial-value update descriptor: {error}"))
+            })
+        })
+        .collect()
+}

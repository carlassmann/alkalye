+#[test]
+fn offline_text_edits_converge_across_early_consolidation() {
+    let server = block_on(Db::open(config(0x71))).unwrap();
+    let mut alice = connect(block_on(Db::open(config(0xa1))).unwrap(), &server);
+    let mut bob = connect(block_on(Db::open(config(0xa2))).unwrap(), &server);
+    let start = "A paragraph with 👩🏽‍💻 and café.\n\n".repeat(2048);
+    insert(&alice.db, &start);
+    settle(&server, &mut [&mut alice, &mut bob]);
+    let mut first = Editor::new(&start, start.len());
+    let mut second = Editor::new(&start, 0);
+    let suffix = "é".repeat(130);
+    let prefix = "語".repeat(130);
+    for character in suffix.chars() {

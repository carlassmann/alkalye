{
	"name": "alkalye",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/server/index.ts",
		"start": "NODE_ENV=production bun src/server/index.ts",
		"build": "bun build.ts",
		"check": "bun scripts/check.ts",
		"check:types": "tsc --noEmit",
		"check:cloudflare-types": "tsc --noEmit -p tsconfig.cloudflare.json",
		"check:format": "prettier --check src tests experiments scripts public/app.html public/app.css public/sw.js public/manifest.webmanifest package.json tsconfig.json tsconfig.cloudflare.json wrangler.jsonc build.ts cli.ts work.config.js README.md",
		"check:test": "bun test ./tests",
		"test": "bun run test:integration",
		"test:e2e": "bun tests/e2e.ts",
		"format": "prettier --write src tests experiments scripts public/app.html public/app.css public/sw.js public/manifest.webmanifest package.json tsconfig.json tsconfig.cloudflare.json wrangler.jsonc build.ts cli.ts work.config.js README.md",
		"ci": "bun scripts/ci.ts",
		"test:integration": "bun scripts/test-integration.ts",
		"test:e2e:full": "bun tests/e2e.ts --full",
		"cloudflare:build": "bun scripts/cloudflare.ts build",
		"cloudflare:dev": "bun scripts/cloudflare.ts dev",
		"cloudflare:deploy": "bun scripts/cloudflare.ts deploy",
		"cloudflare:types": "bun scripts/cloudflare.ts types",
		"cloudflare:check": "bun scripts/cloudflare.ts check",
		"cloudflare:smoke": "bun scripts/cloudflare-smoke.ts",
		"cloudflare:live-smoke": "bun scripts/cloudflare-live-smoke.ts",
		"cloudflare:workspace-smoke": "bun scripts/cloudflare-workspace-smoke.ts",
		"cloudflare:migration-smoke": "bun scripts/cloudflare-workspace-smoke.ts --legacy-migration",
		"cloudflare:sqlite-smoke": "bun scripts/cloudflare-sqlite-smoke.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261001.1",
		"@types/bun": "^1.3.11",
		"@types/react": "19.2.9",
		"@types/react-dom": "19.2.3",
		"prettier": "^3.8.1",
		"typescript": "~5.9.3",
		"wrangler": "4.131.1"
	},
	"bin": {
		"alkalye": "./cli.ts"
	},
	"dependencies": {
		"effect": "4.0.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"tldraw": "5.2.2"
	}
}

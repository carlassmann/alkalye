---
import "#app/index.css"
import { DemoPhoneApp } from "#www/demo/demo-phone-app"
---

<!-- The phone in the landing page demo. It runs in a frame at phone size so
     the app's mobile layout applies; the landing page drives it by messages. -->
<!doctype html>
<html lang="en" class="bg-background text-foreground">
	<head>
		<script is:inline>
			if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
				document.documentElement.classList.add("dark")
			}
		</script>
		<title>Alkalye</title>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body class="h-svh overflow-hidden">
		<DemoPhoneApp client:only="react" />
	</body>
</html>

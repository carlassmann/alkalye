---
import LegalDoc from "@/layouts/LegalDoc.astro"
import changelogSource from "../../public/changelog.json"
import { readChangelog } from "@/shared/changelog"

let entries = readChangelog(changelogSource)

// Date-only strings parse as UTC midnight, so formatting them in the build
// host's zone renders every date a day early west of UTC.
function formatDate(date: string) {
	return new Date(date).toLocaleDateString(undefined, {
		day: "numeric",
		month: "long",
		year: "numeric",
		timeZone: "UTC",
	})
}
---

<LegalDoc
	title="What's new"
	description="Recent changes and improvements in Alkalye."
	subtitle="Everything that changed, newest first."
>
	{
		entries.map(entry => (
			<section>
				<h2>{entry.title}</h2>
				<p class="text-muted-foreground -mt-2 text-sm">{formatDate(entry.date)}</p>
				<ul>
					{entry.notes.map(note => (
						<li>{note}</li>
					))}
				</ul>
			</section>
		))
	}
</LegalDoc>

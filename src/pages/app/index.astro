---
import { PWA } from "#app/main"
import "#app/index.css"
export const prerender = true
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Alkalye - Markdown editor</title>
  <meta name="description" content="Write Markdown offline and sync across devices. Synced data is readable by Alkalye's backend and Jazz Cloud." />
  <link rel="icon" href="/icons/alkalye-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#ffffff" />
  <script is:inline>if (window.matchMedia("(prefers-color-scheme: dark)").matches) document.documentElement.classList.add("dark")</script>
 </head>
 <body class="bg-background text-foreground"><PWA client:only="react" /></body>
</html>

---
import { PWA } from "#app/main"
import "#app/index.css"

export let prerender = true

let requestUrl = new URL(Astro.request.url)
let siteBaseUrl = Astro.site ?? new URL(requestUrl.origin)
let canonicalUrl = new URL(
	requestUrl.pathname + requestUrl.search,
	siteBaseUrl,
).toString()
let ogImageUrl = new URL("/icons/alkalye-social.png", siteBaseUrl).toString()
let pageTitle =
	"Alkalye - beautiful Markdown Editor with E2E Encryption and Realtime Collaboration"
let metaDescription =
	"Alkalye is a beautiful markdown editor with e2e encryption and realtime collaboration. Write securely with live sync across devices."
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
				document.documentElement.classList.add("dark")
			}
		</script>
		<title>{pageTitle}</title>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="viewport" content="initial-scale=1, viewport-fit=cover, width=device-width, user-scalable=no" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Alkalye - Beautiful Markdown Editor" />
		<meta property="og:description" content="beautiful markdown editor with e2e encryption and realtime collaboration. Write securely with live sync across devices." />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Alkalye - Beautiful Markdown Editor" />
		<meta name="twitter:description" content="beautiful markdown editor with e2e encryption and realtime collaboration. Write securely with live sync across devices." />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="robots" content="index, follow" />
		<meta name="keywords" content="markdown editor, e2e encrypted, end-to-end encryption, realtime collaboration, secure writing, privacy" />
		<meta name="author" content="Alkalye" />
		<meta id="theme-color" name="theme-color" content="#ffffff" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Alkalye" />
		<link rel="icon" type="image/png" href="/icons/alkalye-icon.png" />
		<link rel="apple-touch-icon" href="/icons/alkalye-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="preload" href="/docs/welcome.md" as="fetch" crossorigin />
	</head>
	<body class="selection:bg-brand selection:text-white" data-alkalye-ready="false">
		<div id="splash" class="bg-background fixed inset-0 z-50 flex items-center justify-center">
			<div class="text-foreground bg-background flex size-48 flex-col items-center justify-center rounded-3xl font-mono text-4xl font-bold tracking-tighter">
				Alkalye
			</div>
			<p class="sr-only" role="status" aria-live="polite">
				Automation hint: app is booting. Wait for body data-alkalye-ready to
				equal true or window.__alkalyeReady to equal true before interacting
				with the editor.
			</p>
		</div>
		<PWA client:only="react" />
		<script>
			import { startBrowserStartupInstrumentation } from "@/app/lib/browser-startup-instrumentation"

			let appWindow = window as typeof window & {
				__pwaColdStartRedirect?: boolean
				__alkalyeReady?: boolean
				__alkalyeReadyAt?: number
				__alkalyeReadyRoute?: string
				__alkalyeStartupTraceId?: string
				__alkalyeStartupTraceRecord?: (
					event: string,
					details?: Record<string, unknown>,
				) => void
				__alkalyeStartupTraceFlush?: () => void
				__alkalyeStartupTraceClear?: () => void
				__alkalyeStartupTraceHasCurrentEvent?: (event: string) => boolean
			}
			let appNavigator = window.navigator as Navigator & { standalone?: boolean }

			window.__pageLoadTime = Date.now()
			appWindow.__alkalyeReady = false
			appWindow.__alkalyeReadyRoute = "boot"
			;(function () {
				let storageKey = "alkalye:reload-diagnostics"
				let maximumEntries = 200
				let runId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`
				appWindow.__alkalyeStartupTraceId = runId

				function loadEntries(): unknown[] {
					try {
						let stored = localStorage.getItem(storageKey)
						let parsed: unknown = stored ? JSON.parse(stored) : []
						return Array.isArray(parsed) ? parsed : []
					} catch {
						return []
					}
				}

				let entries = loadEntries()
				let persistTimer: ReturnType<typeof setTimeout> | undefined

				function persist() {
					clearTimeout(persistTimer)
					persistTimer = undefined
					try {
						localStorage.setItem(
							storageKey,
							JSON.stringify(entries.slice(-maximumEntries)),
						)
					} catch {
						return
					}
				}

				function record(event: string, details: Record<string, unknown> = {}) {
					entries.push({
						runId,
						at: new Date().toISOString(),
						elapsedMs: Math.round(performance.now() * 10) / 10,
							event,
							details,
						})
					if (entries.length > maximumEntries) {
						entries = entries.slice(-maximumEntries)
					}
					clearTimeout(persistTimer)
					persistTimer = setTimeout(persist, 50)
				}

				appWindow.__alkalyeStartupTraceRecord = record
				appWindow.__alkalyeStartupTraceFlush = persist
				appWindow.__alkalyeStartupTraceClear = () => {
					clearTimeout(persistTimer)
					persistTimer = undefined
					entries = []
					localStorage.removeItem(storageKey)
				}
				appWindow.__alkalyeStartupTraceHasCurrentEvent = event =>
					entries.some(entry => {
						if (typeof entry !== "object" || entry === null) return false
						return (
							"runId" in entry &&
							entry.runId === runId &&
							"event" in entry &&
							entry.event === event
						)
					})

				startBrowserStartupInstrumentation(record)

				let navigation = performance.getEntriesByType("navigation")[0]
				record("boot", {
					path: location.pathname,
					navigationType:
						navigation && "type" in navigation ? navigation.type : "unknown",
					visibility: document.visibilityState,
					online: navigator.onLine,
					standalone:
						matchMedia("(display-mode: standalone)").matches ||
						appNavigator.standalone === true,
					serviceWorkerControlled: Boolean(navigator.serviceWorker?.controller),
				})
				addEventListener("DOMContentLoaded", () =>
					record("dom-content-loaded"),
				)
				addEventListener("load", () => {
					let timing = performance.getEntriesByType("navigation")[0]
					let resources = performance.getEntriesByType("resource")
					record("window-loaded", {
						domInteractiveMs:
							timing &&
							"domInteractive" in timing &&
							typeof timing.domInteractive === "number"
								? Math.round(timing.domInteractive)
								: null,
						loadEventMs:
							timing &&
							"loadEventEnd" in timing &&
							typeof timing.loadEventEnd === "number"
								? Math.round(timing.loadEventEnd)
								: null,
						resourceCount: resources.length,
						scriptCount: resources.filter(
							resource =>
								"initiatorType" in resource && resource.initiatorType === "script",
						).length,
					})
				})
				addEventListener("beforeunload", () => {
					record("beforeunload")
					persist()
				})
				addEventListener("pagehide", event => {
					record("pagehide", { persisted: event.persisted })
					persist()
				})
				addEventListener("pageshow", event =>
					record("pageshow", { persisted: event.persisted }),
				)
				addEventListener("visibilitychange", () =>
					record("visibilitychange", { visibility: document.visibilityState }),
				)
				addEventListener("error", event =>
					record("error", { message: event.message }),
				)
				addEventListener("unhandledrejection", event =>
					record("unhandledrejection", { reason: String(event.reason) }),
				)
				navigator.serviceWorker?.addEventListener("controllerchange", () =>
					record("service-worker-controllerchange"),
				)
			})()
			;(function () {
				let isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent)
				if (!isIOS) return
				let isStandalone =
					window.matchMedia("(display-mode: standalone)").matches ||
					appNavigator.standalone === true
				let isDeepLink = /^\/app\/(doc|spaces)\//.test(location.pathname)
				let isColdStart = !sessionStorage.getItem("pwa-session")
				if (isStandalone && isDeepLink && isColdStart) {
					appWindow.__pwaColdStartRedirect = true
				}
				if (isStandalone) {
					sessionStorage.setItem("pwa-session", "1")
					let setAppHeight = () => {
						let isPortrait = window.innerHeight >= window.innerWidth
						let screenHeight = isPortrait ? screen.height : screen.width
						let height = Math.max(window.innerHeight, screenHeight)

						document.documentElement.style.setProperty(
							"--app-height",
							height + "px",
						)
					}
					setAppHeight()
					window.visualViewport?.addEventListener("resize", setAppHeight)
					window.addEventListener("orientationchange", () =>
						requestAnimationFrame(setAppHeight),
					)
				}
			})()

			function updateThemeColor() {
				let meta = document.getElementById("theme-color")
				if (!meta) return
				let bg = getComputedStyle(document.documentElement)
					.getPropertyValue("--background")
					.trim()
				meta.setAttribute("content", bg)
			}

			updateThemeColor()

			new MutationObserver(mutations => {
				for (let m of mutations) {
					if (m.type === "attributes" && m.attributeName === "class") {
						updateThemeColor()
					}
				}
			}).observe(document.documentElement, { attributes: true })
		</script>
	</body>
</html>

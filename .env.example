# Local dev stores Jazz v2 in .jazz/. Production requires all four JAZZ variables.
JAZZ_PUBLIC_URL=https://www.alkalye.com/jazz
JAZZ_APP_ID=
JAZZ_SERVER_URL=
JAZZ_ADMIN_SECRET=
PUBLIC_TLDRAW_LICENSE_KEY=
# Alkalye's public Syntwin room. Set ENABLED=false to hide the twin.
PUBLIC_SYNTWIN_ROOM_ID=j974c6r0d9xj7d19cmfzzt9qw98hg52b
PUBLIC_SYNTWIN_ENABLED=true
ALKALYE_MCP_BASE_URL=https://www.alkalye.com
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ALKALYE_MCP_TOKEN_KEY=
ALKALYE_OPENAI_APPS_CHALLENGE=
